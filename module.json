{
  "id": "wfrp4e-alchemy",
  "title": "WFRP4e – Old World Alchemy",
  "description": "Alchemy for Warhammer Fantasy Roleplay 4e: magical draughts of the eight Colleges brewed quickly and sustained through the alchemist's magical tether, plus mundane alchemy, apothecary and herbalism closer to the official rules. Alchemical Workshop, recipe memory, potion spoilage, thrown potions and generated compendia. English and Polish.",
  "version": "1.7.0",
  "compatibility": {
    "minimum": "14",
    "verified": "14",
    "maximum": "14"
  },
  "authors": [
    {
      "name": "Tomek (TomasWarchol)",
