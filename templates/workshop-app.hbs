<div class="alchemy-workshop-root">
  <!-- NAGŁÓWEK -->
  <header class="workshop-header">
    <div class="actor-info">
      <img class="actor-portrait" src="{{actor.img}}" title="{{actor.name}}"/>
      <div class="actor-details">
        <h2>{{actor.name}}</h2>
        <span class="actor-date"><i class="fas fa-calendar-alt"></i> {{localize "GOLD_ALCHEMY.Calendar"}}: {{currentDateFormatted}}</span>
      </div>
    </div>

    <div class="header-right-pane">
      <div class="compendium-actions">
        <button type="button" class="btn-compendium" data-action="openIngredientsCompendium" title="{{localize "GOLD_ALCHEMY.Button.OpenIngredientsTooltip"}}">
          <i class="fas fa-boxes-stacked"></i> {{localize "GOLD_ALCHEMY.Button.OpenIngredients"}}
        </button>
        <button type="button" class="btn-compendium" data-action="openPotionsCompendium" title="{{localize "GOLD_ALCHEMY.Button.OpenPotionsTooltip"}}">
          <i class="fas fa-flask"></i> {{localize "GOLD_ALCHEMY.Button.OpenPotions"}}
        </button>
        <button type="button" class="btn-compendium" data-action="openRecipesCompendium" title="{{localize "GOLD_ALCHEMY.Button.OpenRecipesTooltip"}}">
          <i class="fas fa-book-bookmark"></i> {{localize "GOLD_ALCHEMY.Button.OpenRecipes"}}
        </button>
        {{#if isGM}}
          <button type="button" class="btn-compendium btn-gm-action" data-action="createRecipe" title="{{localize "GOLD_ALCHEMY.Editor.CreateTooltip"}}">
            <i class="fas fa-plus-circle"></i> {{localize "GOLD_ALCHEMY.Editor.AddRecipe"}}
          </button>
          <button type="button" class="btn-compendium btn-gm-toggle {{#if showAllWorldRecipes}}active{{/if}}" data-action="toggleAllWorldRecipes" title="{{localize "GOLD_ALCHEMY.Button.ToggleWorldRecipesTooltip"}}">
            <i class="fas {{#if showAllWorldRecipes}}fa-eye{{else}}fa-eye-slash{{/if}}"></i> {{localize "GOLD_ALCHEMY.Button.WorldRecipesMode"}}
          </button>
        {{/if}}
      </div>

      <!-- PASKI ZASOBÓW: PODTRZYMANIE I PAMIĘĆ -->
      <div class="resource-bars-group">
        <!-- PUNKTY PODTRZYMANIA -->
        <div class="capacity-box">
          <div class="capacity-title">
            <i class="fas fa-bolt"></i> {{localize "GOLD_ALCHEMY.Capacity.Title"}}
          </div>
          <div class="capacity-bar-container">
            <div class="capacity-bar" style="width: {{capacity.percent}}%;"></div>
            <span class="capacity-text">{{capacity.used}} / {{capacity.max}} {{localize "GOLD_ALCHEMY.Capacity.Locked"}} ({{localize "GOLD_ALCHEMY.Capacity.Free"}}: {{capacity.available}})</span>
          </div>
        </div>

        <!-- PAMIĘĆ RECEPTUR -->
        <div class="capacity-box memory-box">
          <div class="capacity-title">
            <i class="fas fa-brain"></i> {{localize "GOLD_ALCHEMY.Memory.Title"}}
            {{#if memory.hasChamonBonus}}
              <span class="badge-chamon-affinity" title="{{localize "GOLD_ALCHEMY.Memory.ChamonBonusTooltip"}}">
                <i class="fas fa-coins"></i> Chamon +{{memory.chamonBonus}}
              </span>
            {{/if}}
          </div>
          <div class="capacity-bar-container">
            <div class="capacity-bar memory-bar" style="width: {{memory.percent}}%;"></div>
            <span class="capacity-text">{{memory.used}} / {{memory.max}} {{localize "GOLD_ALCHEMY.Memory.Used"}} ({{localize "GOLD_ALCHEMY.Capacity.Free"}}: {{memory.available}})</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  {{#if isGM}}
    <details class="gm-alchemy-settings">
      <summary><i class="fas fa-sliders"></i> {{localize "GOLD_ALCHEMY.GMSettings.Title" actor=actor.name}}</summary>
      <div class="gm-alchemy-settings-grid">
        <label class="player-workshop-access"><input type="checkbox" name="playerWorkshopEnabled" {{#if playerWorkshopEnabled}}checked{{/if}} /> {{localize "GOLD_ALCHEMY.GMSettings.PlayerAccess"}}</label>
        <label>{{localize "GOLD_ALCHEMY.GMSettings.CapacityMod"}}
          <input type="number" step="1" name="customCapacityMod" value="{{customCapacityMod}}" />
        </label>
        <label>{{localize "GOLD_ALCHEMY.GMSettings.MemoryMod"}}
          <input type="number" step="1" name="customMemoryMod" value="{{customMemoryMod}}" />
        </label>
        <fieldset>
          <legend>{{localize "GOLD_ALCHEMY.GMSettings.Schools"}}</legend>
          {{#each schoolSettings}}
            <label class="school-visibility-option"><input type="checkbox" name="visibleAlchemySchools" value="{{this.id}}" {{#if this.enabled}}checked{{/if}} /> {{this.name}}</label>
          {{/each}}
        </fieldset>
        <button type="button" class="knowledge-btn" data-action="saveActorAlchemySettings"><i class="fas fa-save"></i> {{localize "GOLD_ALCHEMY.GMSettings.Save"}}</button>
      </div>
    </details>
  {{/if}}

  <!-- GŁÓWNE FILTRY KATEGORII -->
  <nav class="category-tabs">
    <button type="button" class="category-btn {{#if (bajeryEq selectedCategory 'all')}}active{{/if}}" data-action="selectCategory" data-category="all">
      <i class="fas fa-th-list"></i> {{localize "GOLD_ALCHEMY.Category.All"}}
    </button>
    <button type="button" class="category-btn {{#if (bajeryEq selectedCategory 'magical-all')}}active{{/if}}" data-action="selectCategory" data-category="magical-all">
      <i class="fas fa-hat-wizard"></i> {{localize "GOLD_ALCHEMY.Category.Colleges"}}
    </button>
    <button type="button" class="category-btn {{#if (bajeryEq selectedCategory 'mundane')}}active{{/if}}" data-action="selectCategory" data-category="mundane">
      <i class="fas fa-bomb"></i> {{localize "GOLD_ALCHEMY.Category.Mundane"}}
    </button>
    <button type="button" class="category-btn {{#if (bajeryEq selectedCategory 'apothecary')}}active{{/if}}" data-action="selectCategory" data-category="apothecary">
      <i class="fas fa-mortar-pestle"></i> {{localize "GOLD_ALCHEMY.Category.Apothecary"}}
    </button>
    <button type="button" class="category-btn {{#if (bajeryEq selectedCategory 'herbal')}}active{{/if}}" data-action="selectCategory" data-category="herbal">
      <i class="fas fa-leaf"></i> {{localize "GOLD_ALCHEMY.Category.Herbal"}}
    </button>
  </nav>

  <!-- PODZAKŁADKI 8 KOLEGIÓW -->
  {{#if showCollegeSubTabs}}
  <nav class="college-subtabs">
    <button type="button" class="college-subbtn {{#if (bajeryEq selectedSubCategory 'all-colleges')}}active{{/if}}" data-action="selectSubCategory" data-subcategory="all-colleges">
      {{localize "GOLD_ALCHEMY.Colleges.AllColleges"}}
    </button>
    {{#each collegeTabs}}
      <button type="button" class="college-subbtn {{this.className}} {{#if (bajeryEq ../selectedSubCategory this.id)}}active{{/if}}" data-action="selectSubCategory" data-subcategory="{{this.id}}">{{this.name}}</button>
    {{/each}}
  </nav>
  {{/if}}

  <!-- PODFILTRY WIEDZY (Z PAMIĘCI / Z KSIĄG) -->
  <nav class="knowledge-filter-bar">
    <button type="button" class="knowledge-btn {{#if isAllKnownFilterActive}}active{{/if}}" data-action="selectKnowledgeFilter" data-knowledge="all">
      <i class="fas fa-layer-group"></i> {{localize "GOLD_ALCHEMY.Knowledge.FilterAll"}}
    </button>
    <button type="button" class="knowledge-btn {{#if (bajeryEq knowledgeFilter 'memorized')}}active{{/if}}" data-action="selectKnowledgeFilter" data-knowledge="memorized">
      <i class="fas fa-brain"></i> {{localize "GOLD_ALCHEMY.Knowledge.FilterMemorized"}} ({{memory.memorizedCount}})
    </button>
    <button type="button" class="knowledge-btn {{#if (bajeryEq knowledgeFilter 'grimoire')}}active{{/if}}" data-action="selectKnowledgeFilter" data-knowledge="grimoire">
      <i class="fas fa-book-open"></i> {{localize "GOLD_ALCHEMY.Knowledge.FilterGrimoires"}} ({{recipeBooksCount}} {{localize "GOLD_ALCHEMY.Knowledge.Books"}})
    </button>
    <button type="button" class="knowledge-btn" data-action="toggleBookManager">
      <i class="fas fa-books"></i> {{localize "GOLD_ALCHEMY.Knowledge.ManageBooks"}}
    </button>
    {{#if isGM}}
      <button type="button" class="knowledge-btn {{#if (bajeryEq knowledgeFilter 'unknown')}}active{{/if}}" data-action="selectKnowledgeFilter" data-knowledge="unknown">
        <i class="fas fa-lock"></i> {{localize "GOLD_ALCHEMY.Knowledge.FilterUnknown"}}
      </button>
    {{/if}}
  </nav>

  {{#if showBookManager}}
    <section class="recipe-books-panel">
      <header class="recipe-books-header">
        <h3><i class="fas fa-book-open"></i> {{localize "GOLD_ALCHEMY.Knowledge.CarriedBooks"}}</h3>
        {{#if isGM}}<small>{{localize "GOLD_ALCHEMY.Knowledge.DropRecipeIntoBook"}}</small>{{/if}}
      </header>
      {{#if recipeBooks.length}}
        <div class="recipe-books-grid">
          {{#each recipeBooks}}
            <article class="recipe-book-card {{#unless this.accessible}}is-inaccessible{{/unless}}" data-book-id="{{this.id}}">
              <div class="recipe-book-title">
                <img src="{{this.img}}" alt="" data-alchemy-image data-fallback-src="icons/sundries/books/book-embossed-gold-green.webp" />
                <div>
                  <strong>{{this.name}}</strong>
                  {{#if this.accessible}}
                    <span class="book-access-status is-accessible"><i class="fas fa-unlock"></i> {{localize "GOLD_ALCHEMY.Knowledge.BookAccessible"}}</span>
                  {{else if (bajeryEq this.accessReason 'equipped')}}
                    <span class="book-access-status"><i class="fas fa-lock"></i> {{localize "GOLD_ALCHEMY.Knowledge.BookNeedsEquipped"}}</span>
                  {{else}}
                    <span class="book-access-status"><i class="fas fa-lock"></i> {{localize "GOLD_ALCHEMY.Knowledge.BookNeedsLanguage"}}: {{this.requiredLanguage}}</span>
                  {{/if}}
                </div>
              </div>
              {{#if ../isGM}}
                <div class="book-requirement-editor">
                  <label>{{localize "GOLD_ALCHEMY.Knowledge.RequiredLanguage"}}</label>
                  <input type="text" name="requiredLanguage" value="{{this.requiredLanguage}}" placeholder="{{localize "GOLD_ALCHEMY.Knowledge.NoLanguageRequirement"}}" />
                  <button type="button" data-action="saveBookRequirements" title="{{localize "GOLD_ALCHEMY.Knowledge.SaveBookRequirements"}}"><i class="fas fa-save"></i></button>
                </div>
              {{/if}}
              <ul class="recipe-book-recipes">
                {{#each this.recipes}}
                  <li>
                    <span>{{this.name}}</span>
                    {{#if ../../isGM}}<button type="button" data-action="removeRecipeFromBook" data-recipe-id="{{this.id}}" title="{{localize "GOLD_ALCHEMY.Knowledge.RemoveFromBook"}}"><i class="fas fa-times"></i></button>{{/if}}
                  </li>
                {{else}}
                  <li class="empty-book-hint">{{localize "GOLD_ALCHEMY.Knowledge.EmptyBook"}}</li>
                {{/each}}
              </ul>
            </article>
          {{/each}}
        </div>
      {{else}}
        <p class="empty-book-hint">{{localize "GOLD_ALCHEMY.Knowledge.NoBooks"}}</p>
      {{/if}}
      {{#if isGM}}
      {{#if unregisteredBooks.length}}
        <div class="unregistered-books">
          <strong>{{localize "GOLD_ALCHEMY.Knowledge.UnregisteredBooks"}}</strong>
          {{#each unregisteredBooks}}
            <button type="button" data-action="registerRecipeBook" data-book-id="{{this.id}}" title="{{localize "GOLD_ALCHEMY.Knowledge.RegisterBook"}}">
              <i class="fas fa-book-medical"></i> {{this.name}}
            </button>
          {{/each}}
        </div>
      {{/if}}
      {{/if}}
    </section>
  {{/if}}

  <!-- GŁÓWNA ZAWARTOŚĆ -->
  <div class="workshop-body">
    <!-- LEWA KOLUMNA: LISTA RECEPTUR -->
    <section class="recipe-list-pane">
      <div class="pane-header-row">
        <h3>{{localize "GOLD_ALCHEMY.RecipeBook"}} ({{recipes.length}})</h3>
        <span class="drag-hint" title="{{localize "GOLD_ALCHEMY.DragDropHintTooltip"}}">
          <i class="fas fa-hand-pointer"></i> {{localize "GOLD_ALCHEMY.DragDropHint"}}
        </span>
      </div>

      <div class="recipe-scroll">
        {{#if recipes.length}}
          {{#each recipes}}
            <div class="recipe-card {{#if (bajeryEq this.id ../selectedRecipe.id)}}selected{{/if}} {{#unless this.isKnown}}card-unknown{{/unless}}" data-action="selectRecipe" data-recipe-id="{{this.id}}" draggable="true">
              <img class="recipe-icon" src="{{this.img}}" loading="lazy" data-alchemy-image data-fallback-src="icons/consumables/potions/bottle-bulb-corked-purple.webp" alt="" />
              <div class="recipe-card-info">
                <span class="recipe-name">
                  {{localize this.name}}
                  {{#if this.isCustom}}<i class="fas fa-feather custom-marker" title="{{localize "GOLD_ALCHEMY.CustomRecipe"}}"></i>{{/if}}
                </span>
                <div class="recipe-tags">
                  <span class="badge badge-cat badge-{{this.category}}">{{this.categoryLabel}}</span>

                  <!-- Odznaki Wiedzy -->
                  {{#if this.isMemorized}}
                    <span class="badge badge-memorized" title="{{localize "GOLD_ALCHEMY.Knowledge.MemorizedTooltip"}}">
                      <i class="fas fa-brain"></i> {{localize "GOLD_ALCHEMY.Knowledge.Memorized"}}
                    </span>
                  {{/if}}
                  {{#if this.isFromBook}}
                    <span class="badge badge-grimoire" title="{{this.bookName}}">
                      <i class="fas fa-book-open"></i> {{this.bookName}}
                    </span>
                  {{/if}}
                  {{#unless this.isKnown}}
                    <span class="badge badge-unknown">
                      <i class="fas fa-lock"></i> {{localize "GOLD_ALCHEMY.Knowledge.Unknown"}}
                    </span>
                  {{/unless}}

                  <!-- Darmowa wiedza Chamonu -->
                  {{#if this.isFreeChamon}}
                    <span class="badge badge-free-chamon" title="{{localize "GOLD_ALCHEMY.Memory.FreeChamonTooltip"}}">
                      <i class="fas fa-coins"></i> {{localize "GOLD_ALCHEMY.Memory.ZeroSlots"}}
                    </span>
                  {{/if}}

                  {{#if this.attunementCost}}
                    <span class="badge badge-cost"><i class="fas fa-link"></i> {{this.attunementCost}} {{localize "GOLD_ALCHEMY.Capacity.Points"}}</span>
                  {{/if}}

                  {{#if this.canBrew}}
                    <span class="badge badge-ready"><i class="fas fa-check"></i> {{localize "GOLD_ALCHEMY.Status.Ready"}}</span>
                  {{else}}
                    <span class="badge badge-missing"><i class="fas fa-xmark"></i> {{localize "GOLD_ALCHEMY.Status.MissingIngredients"}}</span>
                  {{/if}}
                </div>
              </div>
            </div>
          {{/each}}
        {{else}}
          <div class="empty-recipes-notice">
            <p><i class="fas fa-scroll"></i> {{localize "GOLD_ALCHEMY.NoRecipesInView"}}</p>
            {{#unless isGM}}
              <small>{{localize "GOLD_ALCHEMY.NoRecipesPlayerHint"}}</small>
            {{/unless}}
          </div>
        {{/if}}
      </div>
    </section>

    <!-- PRAWA KOLUMNA: SZCZEGÓŁY I WARZENIE -->
    <section class="recipe-details-pane">
      {{#if selectedRecipe}}
        <div class="recipe-header">
          <img class="detail-icon" src="{{selectedRecipe.img}}" data-alchemy-image data-fallback-src="icons/consumables/potions/bottle-bulb-corked-purple.webp" alt="" />
          <div class="header-text-group">
            <h3>{{localize selectedRecipe.name}}</h3>
            <p class="recipe-desc">{{localize selectedRecipe.description}}</p>
          </div>
          {{#if isGM}}
            <div class="gm-recipe-actions">
              <button type="button" class="btn-edit-recipe" data-action="editRecipe" data-recipe-id="{{selectedRecipe.id}}" title="{{localize "GOLD_ALCHEMY.Editor.Edit"}}">
                <i class="fas fa-edit"></i>
              </button>
              {{#if selectedRecipe.isCustom}}
                <button type="button" class="btn-del-recipe" data-action="deleteRecipe" data-recipe-id="{{selectedRecipe.id}}" title="{{localize "GOLD_ALCHEMY.Editor.Delete"}}">
                  <i class="fas fa-trash"></i>
                </button>
              {{/if}}
            </div>
          {{/if}}
        </div>

        <!-- PASEK STANU WIEDZY / AKCJE ZAPAMIĘTYWANIA -->
        <div class="knowledge-banner {{#if selectedRecipe.isMemorized}}banner-memorized{{else if selectedRecipe.isFromBook}}banner-grimoire{{else}}banner-unknown{{/if}}">
          <div class="banner-text">
            {{#if selectedRecipe.isMemorized}}
              <i class="fas fa-brain"></i> {{localize "GOLD_ALCHEMY.Knowledge.KnownFromMemory"}}
              {{#if selectedRecipe.isFromBook}}<br/><small>{{localize "GOLD_ALCHEMY.Knowledge.AlsoInBooks"}}: {{selectedRecipe.bookName}}</small>{{/if}}
            {{else if selectedRecipe.isFromBook}}
              <i class="fas fa-book-open"></i> {{localize "GOLD_ALCHEMY.Knowledge.KnownFromBook"}}: <strong>{{selectedRecipe.bookName}}</strong>
            {{else}}
              <i class="fas fa-lock"></i> {{localize "GOLD_ALCHEMY.Knowledge.NotKnown"}}
            {{/if}}
          </div>

          <div class="banner-controls">
            {{#if selectedRecipe.isMemorized}}
              <button type="button" class="btn-knowledge-action btn-forget" data-action="forgetRecipe" data-recipe-id="{{selectedRecipe.id}}" title="{{localize "GOLD_ALCHEMY.Knowledge.ForgetTooltip"}}">
                <i class="fas fa-eraser"></i> {{localize "GOLD_ALCHEMY.Knowledge.Forget"}}
              </button>
            {{else if selectedRecipe.isFromBook}}
              <button type="button" class="btn-knowledge-action btn-memorize" data-action="memorizeRecipe" data-recipe-id="{{selectedRecipe.id}}" title="{{localize "GOLD_ALCHEMY.Knowledge.MemorizeTooltip"}}">
                <i class="fas fa-graduation-cap"></i> {{localize "GOLD_ALCHEMY.Knowledge.Memorize"}}
              </button>
            {{else}}
              {{#if isGM}}
                <button type="button" class="btn-knowledge-action btn-memorize" data-action="memorizeRecipe" data-recipe-id="{{selectedRecipe.id}}" title="{{localize "GOLD_ALCHEMY.Knowledge.GMAwardTooltip"}}">
                  <i class="fas fa-wand-magic-sparkles"></i> {{localize "GOLD_ALCHEMY.Knowledge.GMAward"}}
                </button>
              {{/if}}
            {{/if}}
          </div>
        </div>

        <div class="details-section">
          <h4><i class="fas fa-sparkles"></i> {{localize "GOLD_ALCHEMY.Details.Effect"}}</h4>
          <p class="effect-desc">{{localize selectedRecipe.effectDescription}}</p>
        </div>

        <div class="details-section">
          <div class="details-section-header">
            <h4><i class="fas fa-mortar-pestle"></i> {{localize "GOLD_ALCHEMY.Details.IngredientsTitle"}}</h4>
            <a class="open-repo-link" data-action="openIngredientsCompendium" title="{{localize "GOLD_ALCHEMY.Button.OpenIngredientsTooltip"}}">
              <i class="fas fa-boxes-stacked"></i> {{localize "GOLD_ALCHEMY.Button.OpenIngredients"}}
            </a>
          </div>
          <ul class="ingredients-list">
            {{#each selectedRecipe.ingredientsStatus}}
              <li class="ing-item {{#if this.sufficient}}ing-ok{{else}}ing-missing{{/if}}">
                <i class="fas {{#if this.sufficient}}fa-check-circle{{else}}fa-circle-xmark{{/if}}"></i>
                <span class="ing-name">{{localize this.name}}</span>
                <span class="ing-qty">{{localize "GOLD_ALCHEMY.Details.Owned"}}: <strong>{{this.owned}}</strong> / {{localize "GOLD_ALCHEMY.Details.Required"}}: <strong>{{this.required}}</strong> · {{this.estimatedCostGC}} {{localize "GOLD_ALCHEMY.Currency.GC"}}</span>
              </li>
            {{/each}}
          </ul>
        </div>

        <div class="brew-controls">
          {{#if pendingBrew}}
            <p class="pending-brew-status"><i class="fas fa-hourglass-half"></i> {{pendingBrew.statusText}} {{#unless pendingBrew.isReady}}{{localize "GOLD_ALCHEMY.Details.WorldTimeMustPass"}}{{/unless}}</p>
            {{#if isGM}}<button type="button" data-action="cancelPendingBrew" class="btn-cancel-brew">{{localize "GOLD_ALCHEMY.Details.CancelBrewing"}}</button>{{/if}}
          {{/if}}
          <div class="control-group">
            <label><i class="fas fa-vial"></i> {{localize "GOLD_ALCHEMY.Details.Laboratory"}}:</label>
            <select name="labTier">
              {{#each labTiers}}
                <option value="{{this.id}}" {{#if (bajeryEq this.id ../selectedLabTier)}}selected{{/if}}>
                  {{localize this.name}}
                </option>
              {{/each}}
            </select>
          </div>

          <div class="control-group">
            <label><i class="fas fa-clock"></i> {{localize "GOLD_ALCHEMY.Details.TimeAndShelfLife"}}:</label>
            <span>{{localize "GOLD_ALCHEMY.Details.CreationTime"}}: {{selectedRecipe.creationTimeLabel}} · {{localize "GOLD_ALCHEMY.Details.MinimumTending"}} · {{localize "GOLD_ALCHEMY.Details.ShelfBase"}}: {{selectedRecipe.shelfLifeDays}} {{localize "GOLD_ALCHEMY.Days"}}</span>
            <span>{{localize "GOLD_ALCHEMY.Details.Doses"}}: {{selectedRecipe.dosesLabel}} · {{localize "GOLD_ALCHEMY.Details.PricePerDose"}}: {{selectedRecipe.priceLabel}}</span>
          </div>

          <button type="button" class="btn-brew" data-action="brewPotion" {{#unless selectedRecipe.canBrew}}disabled title="{{localize "GOLD_ALCHEMY.Details.CannotBrewTooltip"}}"{{/unless}}>
            <i class="fas fa-fire-burner"></i> {{#if selectedRecipe.isPendingBrew}}{{localize "GOLD_ALCHEMY.Details.CompleteBrewing"}}{{else}}{{localize "GOLD_ALCHEMY.Details.StartBrewing"}}{{/if}}
          </button>
        </div>
      {{else}}
        <p class="no-recipe-selected">{{localize "GOLD_ALCHEMY.Details.NoRecipeSelected"}}</p>
      {{/if}}
    </section>
  </div>

  <!-- DOLNA SEKCJA: AKTYWNE PUNKTY PODTRZYMANIA W DRUŻYNIE -->
  {{#if tetheredPotions.length}}
    <footer class="tether-pane">
      <h4><i class="fas fa-link"></i> {{localize "GOLD_ALCHEMY.Tethers.Title"}} ({{tetheredPotions.length}})</h4>
      <div class="tether-list">
        {{#each tetheredPotions}}
          <div class="tether-item">
            <span class="tether-holder"><strong>{{this.holder.name}}</strong></span>
            <span class="tether-potion">{{this.recipeName}} ({{this.quantity}} {{localize "GOLD_ALCHEMY.Pieces"}})</span>
            <span class="tether-cost"><i class="fas fa-lock"></i> {{this.totalCost}} {{localize "GOLD_ALCHEMY.Capacity.Points"}}</span>
            <span class="tether-expiry"><i class="fas fa-hourglass"></i> {{this.expiryDate}}</span>
            <button type="button" class="btn-sever" data-action="severTether" data-uuid="{{this.item.uuid}}" title="{{localize "GOLD_ALCHEMY.Tethers.SeverTooltip"}}">
              <i class="fas fa-scissors"></i> {{localize "GOLD_ALCHEMY.Tethers.Sever"}}
            </button>
          </div>
        {{/each}}
      </div>
    </footer>
  {{/if}}
</div>
